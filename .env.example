# ==============================================================================
# SELLORA ENVIRONMENT VARIABLES
# Production runtime: Cloudflare Workers + D1 (DB binding) + R2 (R2_MEDIA)
# ==============================================================================

# PUBLIC DEPLOYMENT ORIGIN (Set to exact production HTTPS origin; used for Better Auth callbacks, sitemap & canonicals)
APP_URL="http://localhost:3000"

# REQUIRED AUTHENTICATION & OWNER SECRETS (Configure via AI Studio Secrets or `wrangler secret put <NAME>`)
BETTER_AUTH_SECRET="REPLACE_WITH_SECURE_RANDOM_32_CHAR_SECRET"
OWNER_EMAIL="olarindevictor3@gmail.com"
ADMIN_NOTIFICATION_EMAIL="olarindevictor3@gmail.com"

# GOOGLE OAUTH CREDENTIALS (Required for Google Sign-In; Authorized Redirect URI = <APP_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# BREVO TRANSACTIONAL EMAIL (Server secrets)
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="SELLORA"
BREVO_WEBHOOK_SECRET=""

# CLOUDFLARE TURNSTILE (Optional bot protection; requires BOTH secret key and public site key)
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# GOOGLE ANALYTICS 4 & SEARCH CONSOLE (Optional SEO/analytics only — unrelated to Google OAuth login)
VITE_GA_MEASUREMENT_ID=""
GOOGLE_SITE_VERIFICATION=""

# OPTIONAL AI FEATURE (Server secret; storefront works 100% independently without it)
GEMINI_API_KEY=""

# Note: Production database is Cloudflare D1 (`DB` binding in wrangler.toml / worker/index.ts).
# Local Node dev (server.ts) automatically defaults to ./.data/sellora.db; SQLITE_DB_PATH is not required.
